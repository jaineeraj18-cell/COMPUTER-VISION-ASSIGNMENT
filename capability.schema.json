{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interface.ai/schemas/capability/v1.json",
  "title": "capability/v1",
  "description": "A reusable, replayable UI capability recorded from a computer-use discovery run.",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "surface", "target", "steps"],
  "properties": {
    "schema_version": { "const": "capability/v1" },
    "id": { "type": "string", "description": "stable capability name an agent calls, e.g. saucedemo.checkout_review" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1, "description": "immutable once written" },
    "surface": { "enum": ["web", "legacy_web", "desktop"] },
    "approval": { "enum": ["draft", "approved"] },
    "target": {
      "type": "object",
      "required": ["base_url"],
      "properties": {
        "base_url": { "type": "string" },
        "entry_path": { "type": "string" },
        "app_id": { "type": "string", "description": "the vendor product, shared across tenants" },
        "vendor_version": { "type": ["string", "null"] },
        "variant_id": { "type": "string", "description": "which tenant variant this instance targets" }
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["string", "number", "boolean"] },
          "required": { "type": "boolean" },
          "description": { "type": "string" },
          "sensitive": { "type": "boolean", "description": "never persisted to artifact, logs or evidence" },
          "example": { "type": ["string", "null"] }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["string", "number", "boolean"] },
          "description": { "type": "string" },
          "redact": { "type": "boolean" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "outcome_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/outcomeRule" }
    },
    "success": { "$ref": "#/$defs/checkpoint" },
    "variants": {
      "type": "array",
      "description": "per-tenant overrides of a base capability",
      "items": {
        "type": "object",
        "required": ["variant_id"],
        "properties": {
          "variant_id": { "type": "string" },
          "base_url": { "type": ["string", "null"] },
          "step_patches": {
            "type": "object",
            "description": "step id -> partial step to merge",
            "additionalProperties": { "type": "object" }
          },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "discovered_by": { "type": "string" },
        "run_id": { "type": "string" },
        "goal": { "type": "string" },
        "created_at": { "type": "string" },
        "llm_steps": { "type": "integer" },
        "human_interventions": { "type": "integer" }
      }
    },
    "stability": {
      "type": "object",
      "properties": {
        "replays": { "type": "integer" },
        "successes": { "type": "integer" },
        "score": { "type": ["number", "null"] }
      }
    }
  },
  "$defs": {
    "controlRef": {
      "type": "object",
      "required": ["role"],
      "description": "Intent-level description of a control. Resolved at replay time against the observed surface.",
      "properties": {
        "role": { "type": "string", "description": "accessibility role: button, link, textbox, combobox, ..." },
        "name": { "type": "string", "description": "accessible name; may contain {{param}} placeholders" },
        "name_match": { "enum": ["exact", "contains", "regex"] },
        "ordinal": { "type": "integer", "description": "nth control sharing role+name" },
        "anchor_text": { "type": ["string", "null"], "description": "nearby label/row text; the de-facto label in legacy table layouts" },
        "css_hint": { "type": ["string", "null"], "description": "last-resort fallback, never tried first" },
        "frame_hint": { "type": ["string", "null"] },
        "strategies": {
          "type": "array",
          "items": { "enum": ["role_name", "anchor", "css", "text", "ordinal"] },
          "description": "resolution order; the strategy that succeeded is reported in the run log"
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "condition": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["text_present", "text_absent", "url_matches", "control_present"] },
        "value": { "type": "string" },
        "description": { "type": ["string", "null"] }
      }
    },
    "checkpoint": {
      "type": "object",
      "description": "Asserted after a step; all conditions must hold.",
      "properties": {
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "timeout_ms": { "type": "integer" },
        "description": { "type": ["string", "null"] }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "action"],
      "properties": {
        "id": { "type": "string" },
        "action": { "enum": ["navigate", "click", "type", "select", "press_key", "wait_for", "read"] },
        "target": { "$ref": "#/$defs/controlRef" },
        "value_template": { "type": ["string", "null"], "description": "may contain {{param}}" },
        "url_template": { "type": ["string", "null"], "description": "relative to target.base_url" },
        "key": { "type": ["string", "null"] },
        "wait": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["settle", "text", "control", "url", "none"] },
            "value": { "type": ["string", "null"] },
            "timeout_ms": { "type": "integer" }
          }
        },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "extract": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "method": { "enum": ["control_name", "control_value", "regex"] },
              "target": { "$ref": "#/$defs/controlRef" },
              "pattern": { "type": ["string", "null"] },
              "group": { "type": "integer" },
              "redact": { "type": "boolean" }
            }
          }
        },
        "risk": { "enum": ["safe", "risky"] },
        "retries": { "type": "integer" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "outcomeRule": {
      "type": "object",
      "required": ["code", "classification", "when"],
      "description": "A runtime condition this flow knows how to recognise and classify.",
      "properties": {
        "code": { "type": "string" },
        "classification": {
          "enum": ["business_outcome", "recoverable", "hard_failure"],
          "description": "business_outcome = a legitimate answer for the caller; recoverable = handle and continue; hard_failure = stop with evidence"
        },
        "when": { "$ref": "#/$defs/condition" },
        "message": { "type": "string" },
        "recovery": { "enum": ["dismiss_interstitial", "retry_wait", "reload", null] },
        "max_recoveries": { "type": "integer" },
        "applies_to": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
